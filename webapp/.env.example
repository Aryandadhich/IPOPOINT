# Copy this file to webapp/.env and fill in your values
# NEVER commit webapp/.env to git

# Required in production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-very-long-random-secret-key-here

# Optional — set to "development" to enable Flask debug mode locally
FLASK_ENV=development

# Optional — port override (default: 5000)
# PORT=5000
