# IPOPoint — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# Required in production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Optional — defaults to "production"
FLASK_ENV=development

# Optional — defaults to ipo_data.db next to run.py
# DB_PATH=/absolute/path/to/ipo_data.db

# Optional — port number (default 5000)
# PORT=5000
